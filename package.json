{
  "name": "quest-cord",
  "version": "0.1.0",
  "description": "A pink-themed game catalogue with Discord Rich Presence",
  "main": "src/main.js",
  "author": "yay1cc",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.yay1cc.questcord",
    "productName": "Quest-Cord",
    "files": ["src/**/*", "data/**/*", "package.json"],
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
